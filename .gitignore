extensions/cocos-mcp-creator3/service-config.json

#//////////////////////////
# 策划文档 / 设计稿（不入库）
#//////////////////////////
# 约定：与游戏代码无关的资料（策划大纲、需求文档、原型线框、会议记录、
# 参考截图等）统一放在代码目录之外的 ~/Code/我是梗王-文档/，不放这里。
# 以下规则是保险丝：万一有文档误放进本仓库，也不会被提交。
docs/
*.docx
*.doc
*.pptx
*.ppt
*.xlsx
*.xls
*.pdf

